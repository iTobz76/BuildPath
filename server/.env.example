# Copy this file to .env and fill it in. Never commit .env.

# ---- Option A: your own Ollama (free to run) ----
# TUTOR_PROVIDER=ollama
# OLLAMA_URL=http://<ollama-machine-ip>:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_KEEP_ALIVE=5m     # how long the model stays in GPU memory after a question (default 5m)

# ---- Option B: Claude through the Anthropic API (pay-as-you-go) ----
# Create a key at https://platform.claude.com (formerly console.anthropic.com). API usage is billed separately from claude.ai plans.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-5-5

# ---- Either way ----
TUTOR_DAILY_LIMIT=40
